# TalentScope Environment Configuration Template
# DUMMY VALUES ONLY - Never commit real credentials or production secrets.

# Environment: development, staging, production
ENVIRONMENT=development

# Database configuration
# For local development with SQLite:
DATABASE_URL=sqlite:///./hr_insights.db
# For Docker Compose / PostgreSQL:
# DATABASE_URL=postgresql://talentscope:talentscope_dev_pass@localhost:5432/talentscope
POSTGRES_USER=talentscope
POSTGRES_PASSWORD=talentscope_dev_pass
POSTGRES_DB=talentscope

# Authentication & Security
# Generate a secure 32+ character key for production (e.g., openssl rand -hex 32)
# Generate locally; never use a shared or repository-visible value.
JWT_SECRET_KEY=replace-with-a-unique-32-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local LLM Runtime (Ollama / Local OpenAI-Compatible Server)
# Strictly enforced: only loopback URLs (localhost / 127.0.0.1) are accepted by Guard G10
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# Docker Compose runs the API in a container, so it reaches host Ollama through
# the Docker host bridge instead of localhost inside the container.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.1:latest
LLM_TEMPERATURE=0.0
LLM_SEED=42
LLM_NUM_CTX=8192
LLM_TIMEOUT_S=120.0
LLM_MAX_RETRIES=2
LLM_ALLOW_REMOTE=false

# CORS & Server Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
PORT=8000
HOST=0.0.0.0

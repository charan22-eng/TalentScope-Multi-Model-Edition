  "components": {
    "schemas": {
      "Body_batch_batch_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_batch_batch_post"
      },
      "EmployeeFeatures": {
        "properties": {
          "attendance": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Attendance"
          },
          "experience_years": {
            "type": "number",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Experience Years"
          },
          "training_hours": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Training Hours"
          },
          "projects_completed": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Projects Completed"
          },
          "weekly_hours": {
            "type": "integer",
            "maximum": 168.0,
            "minimum": 0.0,
            "title": "Weekly Hours"
          },
          "prev_score": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Prev Score"
          },
          "department": {
            "type": "string",
            "title": "Department"
          },
          "job_level": {
            "type": "string",
            "title": "Job Level"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "attendance",
          "experience_years",
          "training_hours",
          "projects_completed",
          "weekly_hours",
          "prev_score",
          "department",
          "job_level"
        ],
        "title": "EmployeeFeatures"
      },
      "ExplainResponse": {
        "properties": {
          "prediction": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Prediction"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "neighbors": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Neighbors"
          },
          "votes": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Votes"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "attribution": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Attribution"
          },
          "counterfactual_path": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Counterfactual Path"
          }
        },
        "type": "object",
        "required": [
          "prediction",
          "confidence",
          "neighbors",
          "votes",
          "summary",
          "attribution",
          "counterfactual_path"
        ],
        "title": "ExplainResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PredictResponse": {
        "properties": {
          "prediction": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Prediction"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "probabilities": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Probabilities"
          },
          "stability_index": {
            "type": "number",
            "title": "Stability Index"
          }
        },
        "type": "object",
        "required": [
          "prediction",
          "confidence",
          "probabilities",
          "stability_index"
        ],
        "title": "PredictResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
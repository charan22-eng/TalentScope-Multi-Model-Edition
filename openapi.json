            "required": false,
            "schema": {
              "type": "integer",
              "default": 5,
              "title": "K"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmployeeFeatures"

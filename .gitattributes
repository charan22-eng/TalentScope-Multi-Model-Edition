# Enforce LF line endings across all platforms for text, code, config and data
* text=auto eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.sh text eol=lf
Makefile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary files
*.joblib binary
*.pkl binary
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.zip binary
*.pdf binary
